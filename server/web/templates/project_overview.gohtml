{{template "top.gohtml" .}}

<header>
  <h1>{{.P.Name}}</h1>
  <small><code>{{.P.Slug}}</code> · your role: {{.Role}}{{if not .CanEdit}} (view-only){{end}}</small>
</header>

<section>
  <h2>Details</h2>
  <dl>
    <dt>Name</dt><dd>{{.P.Name}}</dd>
    <dt>Description</dt><dd>{{if .P.Description}}{{.P.Description}}{{else}}<small>—</small>{{end}}</dd>
    <dt>Created</dt><dd><small>{{.P.CreatedAt}}</small></dd>
    <dt>Updated</dt><dd><small>{{.P.UpdatedAt}}</small></dd>
  </dl>
  {{if .CanEdit}}
  <form method="post" action="/projects/{{.P.ID}}/update">
    <label>Name <input name="name" value="{{.P.Name}}" required /></label>
    <label>Description <input name="description" value="{{.P.Description}}" placeholder="description" /></label>
    <button type="submit">Save details</button>
  </form>
  {{end}}
  {{if eq (printf "%v" .Role) "owner"}}
  <form method="post" action="/projects/{{.P.ID}}/delete">
    <button type="submit">Delete project</button>
  </form>
  {{end}}
</section>

<section>
  <h2>At a glance</h2>
  <ul>
    <li><a href="/projects/{{.P.ID}}/files"><strong>{{.FileCount}}</strong> <small>files</small></a></li>
    <li><a href="/projects/{{.P.ID}}/versions"><strong>{{.VersionCount}}</strong> <small>versions</small></a></li>
    <li><a href="/projects/{{.P.ID}}/deployments"><strong>{{.DeploymentCount}}</strong> <small>deployments</small></a></li>
    <li><a href="/projects/{{.P.ID}}/triggers"><strong>{{.TriggerCount}}</strong> <small>triggers</small></a></li>
  </ul>
  <p><small>Save a version before wiring triggers or deployments, so they pin a snapshot instead of the live files.</small></p>
</section>

<section>
  <h2>Recent executions</h2>
  {{if .RecentExecutions}}
  <table>
    <thead><tr><th>#</th><th>File</th><th>Source</th><th>Started</th><th>Compile</th><th>Run</th><th></th></tr></thead>
    <tbody>
      {{range .RecentExecutions}}
      <tr>
        <td data-label="#">{{.ID}}</td>
        <td data-label="File">{{.FileName}}</td>
        <td data-label="Source"><data value="{{.Source}}">{{.Source}}</data></td>
        <td data-label="Started"><small>{{.StartedAt}}</small></td>
        <td data-label="Compile">{{with .CompileExitCode}}{{.}}{{else}}<small>—</small>{{end}}</td>
        <td data-label="Run">{{with .RunExitCode}}{{.}}{{else}}<small>—</small>{{end}}</td>
        <td><a href="/projects/{{$.P.ID}}/executions/{{.ID}}">trace</a></td>
      </tr>
      {{end}}
    </tbody>
  </table>
  <p><small><a href="/projects/{{.P.ID}}/executions">All executions →</a></small></p>
  {{else}}
  <p><small>Nothing has run yet. <a href="/projects/{{.P.ID}}/files">Open a file and press Run.</a></small></p>
  {{end}}
</section>

{{template "bottom.gohtml" .}}
