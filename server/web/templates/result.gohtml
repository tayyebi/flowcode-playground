<article>
  <h2>Result <small>· execution #{{.ExecutionID}}</small></h2>

  {{if .Compile.Diagnostics}}
  <h3>Diagnostics</h3>
  <ul>
    {{range .Compile.Diagnostics}}
    <li><data value="{{.Level}}">{{.Level}}</data> line {{.Line}}: {{.Message}}</li>
    {{end}}
  </ul>
  {{end}}

  {{if .Bytecode}}
  <h3>Bytecode <small>· {{.Bytecode.InstructionCount}} instructions, {{.Bytecode.SizeBytes}} bytes</small></h3>
  <table>
    <thead><tr><th>#</th><th>Opcode</th><th>Arg</th></tr></thead>
    <tbody>
      {{range .Bytecode.Instructions}}
      <tr>
        <td>{{.Index}}</td>
        <td><strong>{{.Opcode}}</strong></td>
        <td>{{.Arg}}</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  {{end}}

  {{with .Run}}
  <h3>Trace</h3>
  <pre>{{.Stderr}}</pre>
  {{if .TimedOut}}<p><output role="alert">The run was killed by the wall-clock timeout.</output></p>{{end}}
  {{end}}

  {{if .AppCalls}}
  <h3>App calls <small>· the execution transcript</small></h3>
  <table>
    <thead><tr><th>App</th><th>Status</th><th>Request</th><th>Response</th><th>Duration</th></tr></thead>
    <tbody>
      {{range .AppCalls}}
      <tr>
        <td data-label="App"><code>{{.Name}}</code></td>
        <td data-label="Status">{{.Status}}</td>
        <td data-label="Request"><small>{{.Request}}</small></td>
        <td data-label="Response"><small>{{.Response}}</small></td>
        <td data-label="Duration">{{.DurationMs}} ms</td>
      </tr>
      {{end}}
    </tbody>
  </table>
  <p><small>Logger entries also live in Loki; Mail and HTTP records are kept in the project's history.</small></p>
  {{end}}
</article>
