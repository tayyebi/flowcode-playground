{{template "top.gohtml" .}}

<header>
  <h1>Versions</h1>
  <small>snapshots of every file, restorable as a set</small>
</header>

{{if .CanEdit}}
<form method="post" action="/projects/{{.P.ID}}/versions">
  <label>Label <input name="label" placeholder="label, e.g. v1" required /></label>
  <button type="submit">Save version</button>
</form>
{{end}}

{{if .Versions}}
<table>
  <thead><tr><th>#</th><th>Label</th><th>Saved</th><th></th></tr></thead>
  <tbody>
    {{range .Versions}}
    <tr>
      <td data-label="#">{{.Number}}</td>
      <td data-label="Label">{{.Label}}</td>
      <td data-label="Saved"><small>{{.CreatedAt}}</small></td>
      <td>
        {{if $.CanEdit}}
        <form method="post" action="/projects/{{$.P.ID}}/versions/{{.Number}}/restore">
          <button type="submit">Restore</button>
        </form>
        {{end}}
      </td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p><small>No versions saved yet.</small></p>
{{end}}

{{template "bottom.gohtml" .}}
