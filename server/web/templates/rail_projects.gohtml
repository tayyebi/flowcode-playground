<aside>
  <header>
    <h2>Projects</h2>
    <details>
      <summary>New</summary>
      <form method="post" action="/projects">
        <label>Name <input name="name" placeholder="project name" required /></label>
        <label>Description <input name="description" placeholder="description (optional)" /></label>
        <button type="submit">Create project</button>
      </form>
    </details>
  </header>
  <nav aria-label="Projects">
    {{$active := .Rail.ActiveID}}
    {{range .Rail.Projects}}
    <a href="/projects/{{.ID}}"{{if eq .ID $active}} aria-current="page"{{end}} title="{{.Name}}">{{.Name}}</a>
    {{else}}
    <p><small>No projects yet.</small></p>
    {{end}}
  </nav>
</aside>
