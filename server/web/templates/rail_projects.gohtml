<aside class="rail rail-projects">
  <div class="rail-head">
    <span class="rail-title">Projects</span>
    <a href="#new-project" class="btn btn-primary btn-small">+ New</a>
  </div>
  <nav class="rail-list">
    {{$active := .Rail.ActiveID}}
    {{range .Rail.Projects}}
    <a href="/projects/{{.ID}}" class="rail-link{{if eq .ID $active}} active{{end}}" title="{{.Name}}">{{.Name}}</a>
    {{else}}
    <p class="note">No projects yet.</p>
    {{end}}
  </nav>
</aside>

<div class="modal" id="new-project">
  <div class="modal-card">
    <h2>Create project</h2>
    <form method="post" action="/projects" class="stack-form">
      <input name="name" placeholder="project name" required />
      <input name="description" placeholder="description (optional)" />
      <div class="row-actions">
        <button type="submit" class="btn btn-primary">Create project</button>
        <a href="#" class="btn btn-ghost">Cancel</a>
      </div>
    </form>
  </div>
</div>
