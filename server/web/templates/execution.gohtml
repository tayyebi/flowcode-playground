{{template "top.gohtml" .}}

<header>
  <h1>Execution #{{.Exec.ID}}</h1>
  <small><a href="/projects/{{.P.ID}}/executions">← all executions</a></small>
</header>

<dl>
  <dt>File</dt><dd>{{.Exec.FileName}}</dd>
  <dt>Source</dt><dd><data value="{{.Exec.Source}}">{{.Exec.Source}}</data></dd>
  <dt>Started</dt><dd><small>{{.Exec.StartedAt}}</small></dd>
  <dt>Finished</dt><dd><small>{{.Exec.FinishedAt}}</small></dd>
  {{with .Exec.DurationMs}}<dt>Duration</dt><dd>{{.}} ms</dd>{{end}}
  {{if .Exec.TimedOut}}<dt>Timeout</dt><dd><output role="alert">killed by the wall-clock timeout</output></dd>{{end}}
  {{if .Exec.Error}}<dt>Error</dt><dd><output role="alert">{{.Exec.Error}}</output></dd>{{end}}
</dl>

{{if .Exec.CompileStderr}}
<h2>Compile output</h2>
<pre>{{.Exec.CompileStderr}}</pre>
{{end}}

{{if .Exec.RunStderr}}
<h2>Trace</h2>
<pre>{{.Exec.RunStderr}}</pre>
{{end}}

{{if .AppCalls}}
<h2>App calls <small>· the execution transcript</small></h2>
<table>
  <thead><tr><th>App</th><th>Status</th><th>Request</th><th>Response</th><th>Duration</th><th>When</th></tr></thead>
  <tbody>
    {{range .AppCalls}}
    <tr>
      <td data-label="App"><code>{{.Name}}</code></td>
      <td data-label="Status">{{.Status}}</td>
      <td data-label="Request"><small>{{.Request}}</small></td>
      <td data-label="Response"><small>{{.Response}}</small></td>
      <td data-label="Duration">{{.DurationMs}} ms</td>
      <td data-label="When"><small>{{.CreatedAt}}</small></td>
    </tr>
    {{end}}
  </tbody>
</table>
<p><small>Logger entries are not stored here — they live in the admin-configured Loki instance.</small></p>
{{end}}

{{template "bottom.gohtml" .}}
