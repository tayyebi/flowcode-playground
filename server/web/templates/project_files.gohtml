{{template "top.gohtml" .}}

<aside>
  <header>
    <h2>Files</h2>
    {{if .CanEdit}}
    <details>
      <summary>Add</summary>
      <form method="post" action="/projects/{{.P.ID}}/files/new">
        <label>Name <input name="name" placeholder="new-file.fc" required autocapitalize="none" spellcheck="false" /></label>
        <button type="submit">Add file</button>
      </form>
    </details>
    {{end}}
  </header>
  <nav aria-label="Files">
    {{$pid := .P.ID}}{{$sel := .Selected}}
    {{range .Files}}
    <a href="/projects/{{$pid}}/files?file={{.Name | urlquery}}"{{if and $sel (eq .Name $sel.Name)}} aria-current="page"{{end}} title="{{.Name}}">{{.Name}}</a>
    {{else}}
    <p><small>No files yet.</small></p>
    {{end}}
  </nav>
</aside>

<section>
  {{with .Selected}}
  {{if $.CanEdit}}
  <form method="post" action="/projects/{{$.P.ID}}/files/{{.Name | urlquery}}/save">
    <header>
      <input name="name" value="{{.Name}}" required aria-label="File name" autocapitalize="none" spellcheck="false" />
      <small>updated {{.UpdatedAt}}</small>
      <button type="submit" formaction="/projects/{{$.P.ID}}/files/{{.Name | urlquery}}/save">Save</button>
      <button type="submit" formaction="/projects/{{$.P.ID}}/files/{{.Name | urlquery}}/run">Run ▸</button>
    </header>
    <textarea name="content" spellcheck="false" wrap="off">{{.Content}}</textarea>
  </form>
  <footer>
    <code>{{$.P.Slug}}/{{.Name}}</code>
    <form method="post" action="/projects/{{$.P.ID}}/files/{{.Name | urlquery}}/delete">
      <button type="submit">Delete file</button>
    </form>
  </footer>
  {{else}}
  <header>
    <code>{{.Name}}</code>
    <small>updated {{.UpdatedAt}} · read-only</small>
  </header>
  <textarea spellcheck="false" wrap="off" readonly>{{.Content}}</textarea>
  {{end}}
  {{else}}
  <h2>No file selected</h2>
  <p><small>{{if .CanEdit}}Add a file to get started.{{else}}This project has no files yet.{{end}}</small></p>
  {{end}}

  {{with .Result}}{{template "result.gohtml" .}}{{end}}
</section>

{{template "bottom.gohtml" .}}
