{{template "top.gohtml" .}}

<div class="page-head">
  <h1>KV log</h1>
  <span class="muted">write-side only, see the README</span>
</div>

{{if .KV}}
<table class="list">
  <thead><tr><th>Key</th><th>Value</th><th>Updated</th><th></th></tr></thead>
  <tbody>
    {{range .KV}}
    <tr>
      <td><code>{{.Key}}</code></td>
      <td><code class="wrap">{{.Value}}</code></td>
      <td class="muted">{{.UpdatedAt}}</td>
      <td>
        {{if $.CanEdit}}
        <form method="post" action="/projects/{{$.P.ID}}/kv/{{.Key | urlquery}}/delete" class="inline-form">
          <button type="submit" class="btn btn-danger btn-small">Delete</button>
        </form>
        {{end}}
      </td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p class="note">No store-set keys recorded yet.</p>
{{end}}

{{template "bottom.gohtml" .}}
