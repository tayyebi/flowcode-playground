{{template "top.gohtml" .}}

<header>
  <h1>KV log</h1>
  <small>write-side only, see the README</small>
</header>

{{if .KV}}
<table>
  <thead><tr><th>Key</th><th>Value</th><th>Updated</th><th></th></tr></thead>
  <tbody>
    {{range .KV}}
    <tr>
      <td data-label="Key"><code>{{.Key}}</code></td>
      <td data-label="Value"><small>{{.Value}}</small></td>
      <td data-label="Updated"><small>{{.UpdatedAt}}</small></td>
      <td>
        {{if $.CanEdit}}
        <form method="post" action="/projects/{{$.P.ID}}/kv/{{.Key | urlquery}}/delete">
          <button type="submit">Delete</button>
        </form>
        {{end}}
      </td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p><small>No store-set keys recorded yet.</small></p>
{{end}}

{{template "bottom.gohtml" .}}
