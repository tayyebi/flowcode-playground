{{template "top.gohtml" .}}

<header>
  <h1>Triggers</h1>
  <small>scheduled runs of a project file</small>
</header>

{{if .CanEdit}}
<form method="post" action="/projects/{{.P.ID}}/triggers">
  <label>File
    <select name="fileName" required>
      {{range .Files}}<option value="{{.Name}}">{{.Name}}</option>{{end}}
    </select>
  </label>
  <label>Schedule
    <select name="scheduleType">
      <option value="interval">every</option>
      <option value="daily">daily at (UTC)</option>
    </select>
  </label>
  <label>Seconds <input name="intervalSeconds" type="number" min="1" placeholder="seconds" /></label>
  <label>Daily at <input name="dailyTimeUTC" type="time" /></label>
  <button type="submit">Create trigger</button>
</form>
{{end}}

{{if .Triggers}}
<table>
  <thead><tr><th>File</th><th>Schedule</th><th>Next run</th><th>Last run</th><th></th></tr></thead>
  <tbody>
    {{range .Triggers}}
    <tr>
      <td data-label="File">{{.FileName}}</td>
      <td data-label="Schedule">
        {{if .IntervalSeconds}}every {{.IntervalSeconds}}s{{end}}
        {{if .DailyTimeUTC}}daily at {{.DailyTimeUTC}} UTC{{end}}
        <data value="{{if .Enabled}}on{{else}}off{{end}}">{{if .Enabled}}on{{else}}off{{end}}</data>
      </td>
      <td data-label="Next run"><small>{{.NextRunAt}}</small></td>
      <td data-label="Last run"><small>{{.LastRunAt}}</small></td>
      <td>
        {{if $.CanEdit}}
        <form method="post" action="/projects/{{$.P.ID}}/triggers/{{.ID}}/toggle">
          <button type="submit">{{if .Enabled}}Pause{{else}}Resume{{end}}</button>
        </form>
        <form method="post" action="/projects/{{$.P.ID}}/triggers/{{.ID}}/delete">
          <button type="submit">Delete</button>
        </form>
        {{end}}
      </td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p><small>No triggers.</small></p>
{{end}}

{{template "bottom.gohtml" .}}
