{{template "top.gohtml" .}}

<header>
  <h1>Deployments</h1>
  <small>public webhook URLs — any request runs the workflow</small>
</header>

{{if .CanEdit}}
<form method="post" action="/projects/{{.P.ID}}/deployments">
  <label>File
    <select name="fileName" required>
      {{range .Files}}<option value="{{.Name}}">{{.Name}}</option>{{end}}
    </select>
  </label>
  <button type="submit">Create deployment</button>
</form>
{{end}}

{{if .Deployments}}
<ul>
  {{range .Deployments}}
  <li>
    <code><a href="/deploy/{{.Slug}}">/deploy/{{.Slug}}</a></code>
    <small>{{.FileName}}</small>
    <data value="{{if .Enabled}}enabled{{else}}disabled{{end}}">{{if .Enabled}}enabled{{else}}disabled{{end}}</data>
    {{if $.CanEdit}}
    <form method="post" action="/projects/{{$.P.ID}}/deployments/{{.ID}}/toggle">
      <button type="submit">{{if .Enabled}}Disable{{else}}Enable{{end}}</button>
    </form>
    <form method="post" action="/projects/{{$.P.ID}}/deployments/{{.ID}}/delete">
      <button type="submit">Delete</button>
    </form>
    {{end}}
  </li>
  {{end}}
</ul>
<p><small>A deploy URL is the workflow's webhook: any request to it runs the workflow.</small></p>
{{else}}
<p><small>No deployments.</small></p>
{{end}}

{{template "bottom.gohtml" .}}
