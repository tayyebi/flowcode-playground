<aside>
  <header>
    <h2 title="{{.Rail.Project.Name}}">{{.Rail.Project.Name}}</h2>
  </header>
  <nav aria-label="Project sections">
    {{$pid := .Rail.Project.ID}}{{$sec := .Rail.Section}}
    <a href="/projects/{{$pid}}"{{if eq $sec "overview"}} aria-current="page"{{end}}>Overview</a>
    <a href="/projects/{{$pid}}/files"{{if eq $sec "files"}} aria-current="page"{{end}}>Files</a>
    <a href="/projects/{{$pid}}/versions"{{if eq $sec "versions"}} aria-current="page"{{end}}>Versions</a>
    <a href="/projects/{{$pid}}/logs"{{if eq $sec "logs"}} aria-current="page"{{end}}>Logs</a>
    <a href="/projects/{{$pid}}/triggers"{{if eq $sec "triggers"}} aria-current="page"{{end}}>Triggers</a>
    <a href="/projects/{{$pid}}/executions"{{if eq $sec "executions"}} aria-current="page"{{end}}>Executions</a>
  </nav>
  <nav aria-label="Shipping">
    <a href="/projects/{{$pid}}/deployments"{{if eq $sec "deployments"}} aria-current="page"{{end}}>Deployments</a>
    <a href="/projects/{{$pid}}/kv"{{if eq $sec "kv"}} aria-current="page"{{end}}>KV</a>
  </nav>
</aside>
