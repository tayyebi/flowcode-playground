<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{.Title}} · FlowCode Playground</title>
    <link rel="stylesheet" href="/static/style.css" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#9193;</text></svg>" />
  </head>
  <body>
    <nav class="topnav">
      <a href="/projects" class="topnav-brand">FlowCode Playground</a>
      <span class="spacer"></span>
      {{if .AdminEnabled}}
      <form method="post" action="/logout" class="inline-form">
        <button type="submit" class="btn btn-ghost">Log out</button>
      </form>
      {{end}}
    </nav>
    <main class="page">
      {{if .Flash}}<p class="flash {{if .FlashOK}}flash-ok{{else}}flash-err{{end}}">{{.Flash}}</p>{{end}}
