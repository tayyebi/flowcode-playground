{{template "top.gohtml" .}}

<h1>{{if eq .App "mail"}}Mail app{{else if eq .App "http"}}HTTP app{{else if eq .App "logger"}}Logger app{{else}}App{{end}} — Logs</h1>
<p class="note">This app's own log file (<code>data/logs/{{.App}}.log</code>), newest first — one line per bridge call, successes and failures alike. User log entries live only in Loki, the Logger app's external backend; mail bodies live only in the mail system.</p>

<form method="get" action="{{if eq .App "mail"}}/admin/mail/logs{{else if eq .App "http"}}/admin/http/logs{{else}}/admin/logger/logs{{end}}" class="row-form">
  <input name="user" value="{{.UserFilter}}" placeholder="filter by user" size="32" />
  <button>filter</button>
  {{if .UserFilter}}<a href="?">clear</a>{{end}}
</form>

{{if .Entries}}
<table class="list">
  <thead><tr><th>When (UTC)</th><th>Call</th><th>User</th><th>Status</th><th>Duration</th><th>Request</th><th>Response</th><th>Exec</th></tr></thead>
  <tbody>
    {{range .Entries}}
    <tr>
      <td class="muted">{{.Time}}</td>
      <td><code>{{.Name}}</code></td>
      <td class="muted">{{.User}}</td>
      <td>{{.Status}}</td>
      <td class="num">{{.DurationMs}} ms</td>
      <td class="muted wrap">{{.Request}}</td>
      <td class="muted wrap">{{.Response}}</td>
      <td class="num">{{if .ExecID}}#{{.ExecID}}{{end}}</td>
    </tr>
    {{end}}
  </tbody>
</table>
{{else}}
<p class="note">No entries{{if .UserFilter}} for this user{{end}} yet.</p>
{{end}}

{{template "bottom.gohtml" .}}
