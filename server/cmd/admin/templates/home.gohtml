{{template "top.gohtml" .}}

<h1>Administration</h1>
<p><small>A separate service from the playground: its own sign-on, its own
allowlist ({{.AdminCount}} administrator(s)), one shared database.</small></p>

<dl>
  <dt>Mail app</dt><dd>{{if .Mail}}<data value="enabled">enabled</data>{{else}}<data value="disabled">disabled</data>{{end}} <a href="/admin/mail">configure</a></dd>
  <dt>HTTP app</dt><dd>{{if .HTTP}}<data value="enabled">enabled</data>{{else}}<data value="disabled">disabled</data>{{end}} <a href="/admin/http">configure</a></dd>
  <dt>Logger app</dt><dd>{{if .Logger}}<data value="enabled">enabled</data>{{else}}<data value="disabled">disabled</data>{{end}} <a href="/admin/logger">configure</a></dd>
  <dt>Default quotas</dt><dd>mail {{.Quotas.MailPerMinute}}/min · http {{.Quotas.HTTPPerMinute}}/min · logger {{.Quotas.LoggerPerMinute}}/min</dd>
</dl>

{{template "bottom.gohtml" .}}
