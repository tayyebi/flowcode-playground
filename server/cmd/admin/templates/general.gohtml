{{template "top.gohtml" .}}

<h1>General</h1>
<p><small>Sandbox limits apply when the app service restarts; the app picks the
saved values up on the next reload (at most a minute). The service token
authenticates the JSON API for scripts — rotating it shows the new value
exactly once.</small></p>

<form method="post" action="/admin/general">
  <fieldset>
    <legend>Sandbox limits</legend>
    <label>Run timeout <input name="timeoutSeconds" type="number" value="{{.Run.TimeoutSeconds}}" placeholder="seconds" /></label>
    <label>Max concurrent <input name="maxConcurrent" type="number" value="{{.Run.MaxConcurrent}}" placeholder="runs" /></label>
    <label>Site rate <input name="ratePerMinute" type="number" value="{{.Run.RatePerMinute}}" placeholder="per minute" /></label>
    <label>Site burst <input name="rateBurst" type="number" value="{{.Run.RateBurst}}" placeholder="burst" /></label>
    <label>Deploy rate <input name="deployRatePerMinute" type="number" value="{{.Run.DeployRatePerMinute}}" placeholder="per minute" /></label>
    <label>Deploy burst <input name="deployRateBurst" type="number" value="{{.Run.DeployRateBurst}}" placeholder="burst" /></label>
    <label>Output cap <input name="outputCapBytes" type="number" value="{{.Run.OutputCapBytes}}" placeholder="bytes" /></label>
    <button type="submit">Save general settings</button>
  </fieldset>
</form>

<form method="post" action="/admin/service-token/rotate">
  <button type="submit">Rotate the service token</button>
</form>

{{template "bottom.gohtml" .}}
