{{template "top.gohtml" .}}

<h1>HTTP app — Configuration</h1>
<p><small>UrlFetchApp.fetch runs server-side. An empty allowlist allows every
destination; one domain per line, <code>*.example.com</code> for subdomains.</small></p>

<form method="post" action="/admin/http">
  <fieldset>
    <legend>Settings</legend>
    <label><input type="checkbox" name="enabled" {{if .HTTP.Enabled}}checked{{end}} /> Enable the HTTP app</label>
    <label>Allowed domains
      <textarea name="allowedDomains" placeholder="api.example.com&#10;*.internal.local">{{range .HTTP.AllowedDomains}}{{.}}
{{end}}</textarea>
    </label>
    <label>Timeout <input name="timeoutSeconds" type="number" value="{{.HTTP.TimeoutSeconds}}" placeholder="seconds" /></label>
    <label>Response cap <input name="responseCapBytes" type="number" value="{{.HTTP.ResponseCapBytes}}" placeholder="bytes" /></label>
    <button type="submit">Save HTTP settings</button>
  </fieldset>
</form>

{{template "bottom.gohtml" .}}
