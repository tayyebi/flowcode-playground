{{template "top.gohtml" .}}

<h1>Administrators</h1>
<p class="note">The allowlist for this administration area. Add someone by email —
they sign in with the admin single sign-on on their next visit. A row's
subject binds on first login; removing a row also kills their session.</p>

<form method="post" action="/admin/administrators/add" class="card row-form">
  <input name="email" placeholder="admin@example.com" />
  <input name="name" placeholder="name (optional)" />
  <button type="submit" class="btn btn-primary">Allowlist</button>
</form>

<table class="list">
  <thead><tr><th>Email</th><th>Name</th><th>Added</th><th>Last login</th><th></th></tr></thead>
  <tbody>
    {{range .Admins}}
    <tr>
      <td>{{.Email}}</td>
      <td>{{.Name}}</td>
      <td class="muted">{{.CreatedAt}}</td>
      <td class="muted">{{if .Subject}}{{.LastLoginAt}}{{else}}<span class="muted">never signed in</span>{{end}}</td>
      <td>
        {{if eq .ID $.CurrentAdminID}}
        <span class="muted">you</span>
        {{else}}
        <form method="post" action="/admin/administrators/remove" class="inline-form">
          <input type="hidden" name="id" value="{{.ID}}" />
          <button type="submit" class="btn btn-danger btn-small">Remove</button>
        </form>
        {{end}}
      </td>
    </tr>
    {{end}}
  </tbody>
</table>

{{template "bottom.gohtml" .}}
