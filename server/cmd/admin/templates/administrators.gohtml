{{template "top.gohtml" .}}

<h1>Administrators</h1>
<p><small>The allowlist for this administration area. Add someone by email —
they sign in with the admin single sign-on on their next visit. A row's
subject binds on first login; removing a row also kills their session.</small></p>

<form method="post" action="/admin/administrators/add">
  <label>Email <input type="email" name="email" placeholder="admin@example.com" autocomplete="off" /></label>
  <label>Name <input name="name" placeholder="name (optional)" /></label>
  <button type="submit">Allowlist</button>
</form>

<table>
  <thead><tr><th>Email</th><th>Name</th><th>Added</th><th>Last login</th><th></th></tr></thead>
  <tbody>
    {{range .Admins}}
    <tr>
      <td data-label="Email">{{.Email}}</td>
      <td data-label="Name">{{.Name}}</td>
      <td data-label="Added"><small>{{.CreatedAt}}</small></td>
      <td data-label="Last login"><small>{{if .Subject}}{{.LastLoginAt}}{{else}}never signed in{{end}}</small></td>
      <td>
        {{if eq .ID $.CurrentAdminID}}
        <small>you</small>
        {{else}}
        <form method="post" action="/admin/administrators/remove">
          <input type="hidden" name="id" value="{{.ID}}" />
          <button type="submit">Remove</button>
        </form>
        {{end}}
      </td>
    </tr>
    {{end}}
  </tbody>
</table>

{{template "bottom.gohtml" .}}
