{{template "top.gohtml" .}}

<h1>Users</h1>
<p><small>Platform users, read-only. Administrators are a separate identity —
see <a href="/admin/administrators">Administrators</a>.</small></p>

<table>
  <thead><tr><th>Email</th><th>Name</th><th>First seen</th><th>Last login</th></tr></thead>
  <tbody>
    {{range .Users}}
    <tr>
      <td data-label="Email">{{.Email}}</td>
      <td data-label="Name">{{.Name}}</td>
      <td data-label="First seen"><small>{{.CreatedAt}}</small></td>
      <td data-label="Last login"><small>{{.LastLoginAt}}</small></td>
    </tr>
    {{end}}
  </tbody>
</table>

{{template "bottom.gohtml" .}}
