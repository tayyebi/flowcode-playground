{{/* The section rail of the selected area. Each app gets Configuration /
     Logs / Rate limits; System gets its own pages. */}}
<aside>
  <header>
    <h2>{{if eq .Rail.Area "mail"}}Mail app{{else if eq .Rail.Area "http"}}HTTP app{{else if eq .Rail.Area "logger"}}Logger app{{else}}System{{end}}</h2>
  </header>
  <nav aria-label="Sections">
    {{$area := .Rail.Area}}{{$sec := .Rail.Section}}
    {{if eq $area "system"}}
    <a href="/admin/users"{{if eq $sec "users"}} aria-current="page"{{end}}>Users</a>
    <a href="/admin/executions"{{if eq $sec "executions"}} aria-current="page"{{end}}>Executions</a>
    <a href="/admin/administrators"{{if eq $sec "administrators"}} aria-current="page"{{end}}>Administrators</a>
    <a href="/admin/general"{{if eq $sec "general"}} aria-current="page"{{end}}>General</a>
    {{else}}
    <a href="/admin/{{$area}}"{{if eq $sec "config"}} aria-current="page"{{end}}>Configuration</a>
    <a href="/admin/{{$area}}/logs"{{if eq $sec "logs"}} aria-current="page"{{end}}>Logs</a>
    <a href="/admin/quotas?app={{$area}}"{{if eq $sec "quotas"}} aria-current="page"{{end}}>Rate limits</a>
    {{end}}
  </nav>
</aside>
