<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{.Title}} · Administration</title>
    <!-- ?v= busts the 7-day browser cache nginx gives /static when the
         stylesheet changes; bump it on every style.css edit. -->
    <link rel="stylesheet" href="/static/style.css?v=2" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>&#9881;&#65039;</text></svg>" />
  </head>
  <body{{if .Rail}} class="app"{{end}}>
    <nav class="topnav">
      <a href="/admin" class="topnav-brand">Administration</a>
      <span class="spacer"></span>
      <form method="post" action="/admin/logout" class="inline-form">
        <button type="submit" class="btn btn-ghost">Log out</button>
      </form>
    </nav>
    {{if .Rail}}
    <div class="app-body">
      {{template "rail_areas.gohtml" .}}
      {{if .Rail.Area}}{{template "rail_admin_sections.gohtml" .}}{{end}}
      <main class="app-main">
        {{if .Flash}}<p class="flash {{if .FlashOK}}flash-ok{{else}}flash-err{{end}}">{{.Flash}}</p>{{end}}
    {{else}}
    <main class="page">
      {{if .Flash}}<p class="flash {{if .FlashOK}}flash-ok{{else}}flash-err{{end}}">{{.Flash}}</p>{{end}}
    {{end}}
