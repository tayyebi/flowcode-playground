<aside>
  <header>
    <h2>Admin</h2>
  </header>
  <nav aria-label="Apps">
    {{$area := .Rail.Area}}
    <a href="/admin/mail"{{if eq $area "mail"}} aria-current="page"{{end}}>Mail app</a>
    <a href="/admin/http"{{if eq $area "http"}} aria-current="page"{{end}}>HTTP app</a>
    <a href="/admin/logger"{{if eq $area "logger"}} aria-current="page"{{end}}>Logger app</a>
  </nav>
  <nav aria-label="System">
    <a href="/admin/users"{{if eq $area "system"}} aria-current="page"{{end}}>System</a>
  </nav>
</aside>
