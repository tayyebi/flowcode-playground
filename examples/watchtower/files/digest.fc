use ai
use form
use email
use storage

workflow: WatchtowerDailyDigest

step collect:
    memory.fetch
        key = "watchtower.status"
end

step summary:
    ai.generate
        prompt = "summarize today's availability"
        input = collect
end

step rendered:
    form.render
        form_id = "watchtower_daily_digest"
        data = summary
end

step mailed:
    email.send
        to = "ops@example.com"
        subject = "Watchtower daily digest"
        body = "availability summary for the last 24h"
end

step archived:
    storage.upload
        bucket = "watchtower-digests"
        file = rendered
end

step saved:
    store set
        key = "watchtower.digest.last"
end

step done:
    emit
        value = "digest_sent"
        metadata = mailed
end
