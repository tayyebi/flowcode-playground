# Go build output. `go build ./...` names the binary after the directory, and
# `go build -o playground` is what scripts/docker-entrypoint.sh and the
# README use.
server/server
server/playground
server/admin

# docker-compose.yml bind-mounts the whole repo, so every build cache
# (apk, FlowCode's git clone, Go's module/build cache, npm's cache) and the
# compiled binaries live here on the host, deliberately, across deploys.
/.buildcache/

# data/ — the host-side runtime data docker mounts, never committed: the
# PostgreSQL files (data/postgres), TLS certificates (data/certs), per-app
# operational logs (data/logs), Loki's store (data/loki), and the legacy
# SQLite database from before the PostgreSQL migration
# (data/playground.db — kept locally, it holds user content). The mail
# relay's spool is the one exception — a named volume, because Postfix
# enforces spool ownership that bind mounts cannot carry.
/data/

# Local environment overrides
.env
.env.local

# AI tools
.zcodeignore
.claude
# Python bytecode
__pycache__/
